import requests
from bs4 import BeautifulSoup
import pandas as pd

url = "https://www.prosportstransactions.com/football/Search/SearchResults.php?Player=&Team=&BeginDate=2010-01-01&EndDate=&ILChkBx=yes&submit=Search"
params = {
    "Player": "",
    "Team": "",
    "BeginDate": "2010-01-01",
    "EndDate": "",
    "ILChkBx": "yes",
    "submit": "Search",
    "start": 0
}

all_data = []

while True:
    print(f"Scraping page starting at {params['start']}...")
    response = requests.get(url, params=params)
    soup = BeautifulSoup(response.text, "html.parser")

    # Get the first table (no class)
    tables = soup.find_all("table")
    if not tables:
        break  # No table, no data
    rows = tables[0].find_all("tr")[1:]  # Skip header

    if not rows:
        break  # No more data to process

    for row in rows:
        cells = row.find_all("td")
        if len(cells) >= 5:
            date = cells[0].text.strip()
            team = cells[1].text.strip()
            acquired = cells[2].text.strip()
            relinquished = cells[3].text.strip()
            notes = cells[4].text.strip()
            all_data.append([date, team, acquired, relinquished, notes])

    params['start'] += 25  # Pagination increment

# Save to CSV
df = pd.DataFrame(all_data, columns=["Date", "Team", "Acquired", "Relinquished", "Notes"])
df.to_csv("ir_data_2010_onward.csv", index=False)
print(f"✅ Done! Scraped {len(df)} rows and saved to 'ir_data_2010_onward.csv'")