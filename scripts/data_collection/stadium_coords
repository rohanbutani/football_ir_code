# Step 2: Define Haversine distance function
def haversine(lat1, lon1, lat2, lon2):
    R = 3958.8  # Earth radius in miles
    lat1, lon1, lat2, lon2 = map(radians, [lat1, lon1, lat2, lon2])
    dlon = lon2 - lon1
    dlat = lat2 - lat1
    a = sin(dlat/2)**2 + cos(lat1) * cos(lat2) * sin(dlon/2)**2
    c = 2 * asin(sqrt(a))
    return R * c

# Step 3: Load play-by-play data for 2018–2024
seasons = list(range(2018, 2025))
pbp = import_pbp_data(seasons)

# Step 4: Build schedule of unique games
games = pbp[['game_id', 'season', 'week', 'home_team', 'away_team']].drop_duplicates()

# Step 5: Create long-format schedule with one row per team per game
home_rows = games.rename(columns={'home_team': 'team', 'away_team': 'opponent'})
home_rows['is_home'] = True
away_rows = games.rename(columns={'away_team': 'team', 'home_team': 'opponent'})
away_rows['is_home'] = False

long_schedule = pd.concat([home_rows, away_rows], ignore_index=True)

# Step 6: Map team and opponent to coordinates
def get_coords(team):
    return stadium_coords.get(team, (np.nan, np.nan))

long_schedule[['team_lat', 'team_lon']] = long_schedule['team'].apply(lambda x: pd.Series(get_coords(x)))
long_schedule[['opp_lat', 'opp_lon']] = long_schedule['opponent'].apply(lambda x: pd.Series(get_coords(x)))

# Step 7: Compute round-trip distance for away games only
away_games = long_schedule[long_schedule['is_home'] == False].copy()
away_games['round_trip_miles'] = away_games.apply(
    lambda row: 2 * haversine(row['team_lat'], row['team_lon'], row['opp_lat'], row['opp_lon']),
    axis=1
)

# Step 8: Aggregate total travel per team-season
team_season_miles = (
    away_games.groupby(['team', 'season'])['round_trip_miles']
    .sum()
    .reset_index()
    .rename(columns={'round_trip_miles': 'total_round_trip_miles'})
)

# Step 9: Export or merge with player data
team_season_miles.to_csv(str(ROOT / "data/raw/travel_surface/team_season_travel_miles.csv"), index=False)
print("✅ Saved team_season_travel_miles.csv with round-trip mileage per team-season.")